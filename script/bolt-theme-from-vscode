#!/usr/bin/env python3
"""Regenerates the syntax colors of Bolt's theme from a VS Code color theme.

Every Zed highlight capture is mapped to the TextMate scope stack VS Code's grammars produce for the same token, and
the VS Code theme's `tokenColors` are resolved with TextMate's selector rules (deepest scope, then most specific
selector, then last rule wins). UI colors and non-syntax keys of the Bolt theme are left untouched.

Usage: script/bolt-theme-from-vscode [path/to/vscode-theme.json]
Default source: One Dark Pro installed in Cursor or VS Code.
"""

import glob
import json
import os
import re
import sys

BOLT_THEME = os.path.join(
    os.path.dirname(__file__), "..", "assets", "themes", "one_dark_pro_cursor", "one_dark_pro_cursor.json"
)
DEFAULT_SOURCES = [
    "~/.cursor/extensions/zhuangtongfa.material-theme-*/themes/OneDark-Pro.json",
    "~/.vscode/extensions/zhuangtongfa.material-theme-*/themes/OneDark-Pro.json",
]

# Zed capture -> TextMate scope stack (outermost first) of the equivalent VS Code token.
# Language-suffixed captures (`.css`, `.jsx`, `.template`, …) exist where VS Code colors the same Zed category
# differently per language; other themes fall back to the unsuffixed key.
CAPTURES = {
    "attribute": ["text.html.vue", "meta.tag", "entity.other.attribute-name.html"],
    "attribute.jsx": ["source.tsx", "meta.tag.tsx", "entity.other.attribute-name.tsx"],
    "boolean": ["source.ts", "constant.language.boolean.true.ts"],
    "comment": ["source.ts", "comment.line.double-slash.ts"],
    "comment.doc": ["source.ts", "comment.block.documentation.ts"],
    "constant": ["source.ts", "variable.other.constant.ts"],
    "constant.builtin": ["source.ts", "constant.language.null.ts"],
    "constructor": ["source.ts", "meta.method.declaration.ts", "storage.type.ts"],
    "embedded": ["source.ts", "meta.embedded.line.ts"],
    "emphasis": ["text.html.markdown", "markup.italic.markdown"],
    "emphasis.strong": ["text.html.markdown", "markup.bold.markdown"],
    "enum": ["source.ts", "entity.name.type.enum.ts"],
    "function": ["source.ts", "meta.function-call.ts", "entity.name.function.ts"],
    "function.builtin": ["source.ts", "support.function.ts"],
    "function.css": ["source.css", "meta.property-value.css", "support.function.misc.css"],
    "function.decorator": ["source.ts", "meta.decorator.ts", "entity.name.function.ts"],
    "function.macro": ["source.rust", "entity.name.function.macro.rust"],
    "function.method": ["source.ts", "meta.function-call.ts", "entity.name.function.ts"],
    "keyword": ["source.ts", "storage.type.ts"],
    "keyword.control": ["source.ts", "keyword.control.flow.ts"],
    "keyword.directive": ["text.html.vue", "meta.attribute.directive.vue", "entity.other.attribute-name.html.vue"],
    "keyword.import": ["source.ts", "keyword.control.import.ts"],
    "keyword.jsdoc": ["source.ts", "comment.block.documentation.ts", "storage.type.class.jsdoc"],
    "keyword.operator": ["source.ts", "keyword.operator.expression.typeof.ts"],
    "label": ["source.ts", "entity.name.label.ts"],
    "link_text": ["text.html.markdown", "string.other.link.title.markdown"],
    "link_uri": ["text.html.markdown", "markup.underline.link.markdown"],
    "namespace": ["source.ts", "entity.name.type.module.ts"],
    "number": ["source.ts", "constant.numeric.decimal.ts"],
    "operator": ["source.ts", "keyword.operator.assignment.ts"],
    "operator.arrow": ["source.ts", "meta.arrow.ts", "storage.type.function.arrow.ts"],
    "preproc": ["source.c", "meta.preprocessor.c"],
    "property": ["source.ts", "meta.property.object.ts", "variable.other.property.ts"],
    "property.css": ["source.css", "meta.property-name.css", "support.type.property-name.css"],
    "property.json_key": ["source.json", "meta.structure.dictionary.json", "support.type.property-name.json"],
    "property.readonly": ["source.ts", "variable.other.constant.property.ts"],
    "punctuation": ["source.ts", "meta.brace.round.ts"],
    "punctuation.bracket": ["source.ts", "meta.brace.round.ts"],
    "punctuation.bracket.html": ["text.html.vue", "meta.tag", "punctuation.definition.tag.begin.html"],
    "punctuation.bracket.jsx": ["source.tsx", "meta.tag.tsx", "punctuation.definition.tag.begin.tsx"],
    "punctuation.delimiter": ["source.ts", "punctuation.separator.comma.ts"],
    "punctuation.delimiter.html": ["text.html.vue", "meta.tag", "punctuation.separator.key-value.html"],
    "punctuation.delimiter.jsx": ["source.tsx", "meta.tag.tsx", "keyword.operator.assignment.tsx"],
    "punctuation.list_marker": ["text.html.markdown", "markup.list.unnumbered.markdown",
                                "punctuation.definition.list.begin.markdown"],
    "punctuation.markup": ["text.html.markdown", "markup.heading.markdown", "punctuation.definition.heading.markdown"],
    # Vue `{{ }}` interpolation delimiters.
    "punctuation.special": ["text.html.vue", "punctuation.definition.interpolation.begin.html.vue"],
    "punctuation.special.template": ["source.ts", "meta.template.expression.ts",
                                     "punctuation.definition.template-expression.begin.ts"],
    "selector": ["source.css", "meta.selector.css", "entity.other.attribute-name.class.css"],
    "selector.class": ["source.css", "meta.selector.css", "entity.other.attribute-name.class.css"],
    "selector.id": ["source.css", "meta.selector.css", "entity.other.attribute-name.id.css"],
    "selector.pseudo": ["source.css", "meta.selector.css", "entity.other.attribute-name.pseudo-class.css"],
    "string": ["source.ts", "string.quoted.double.ts"],
    "string.escape": ["source.ts", "string.quoted.double.ts", "constant.character.escape.ts"],
